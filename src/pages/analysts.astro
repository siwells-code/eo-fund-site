---
import Layout from '../layouts/Layout.astro';

const title = "The Team · The Epsilon Omicron Fund";
const description = "The team behind the Epsilon Omicron Fund — founders and portfolio managers.";

// Display order:
// Founders: Jason first (President), then directors alphabetical by first name.
// Portfolio Managers: alphabetical by first name.
const founders = [
	{
		name: 'Jason Greenblatt',
		role: 'President',
		initials: 'JG',
		photo: '/images/analysts/jason.jpeg',
		bio: 'Jason Greenblatt is a junior from Port Washington, New York studying Business Administration with a minor in Legal Studies at the USC Marshall School of Business. As President of the Epsilon Omicron Fund, Jason brings a value-oriented investment philosophy developed through his leadership of the USC Value Investing Group and hands-on experience across Wall Street. He spent the summer of 2024 as an Equity Options Analyst at Oppenheimer & Co. and the summer of 2025 as a Restructuring Analyst at Alvarez & Marsal, giving him a unique lens across both public markets and special situations. Jason currently serves as a Portfolio Manager for the USC Marshall USIF Fund and as Treasurer of Sigma Nu, and will be joining PJT Partners as a Restructuring Summer Analyst in 2026. He holds a FINRA Series 65 license, maintains a 4.0 GPA, and has been investing independently since 2021.',
	},
	{
		name: 'Jack Renaud',
		role: 'Director of Healthcare & Financials',
		initials: 'JR',
		photo: '/images/analysts/jack.jpeg',
		objectPosition: 'top',
		bio: 'Jack Renaud is a junior from Boston, MA studying Business Administration at the USC Marshall School of Business, with a minor in Mathematical Data Analytics. He is interning at Loon Lake Capital in the summer of 2026 and with Evercore as an Investment Banking Summer Analyst in 2027. Jack specializes in the healthcare and biotechnology sector.',
	},
	{
		name: 'Mark Reshwan',
		role: 'Director of Consumer Staples & Discretionary',
		initials: 'MR',
		photo: null,
		bio: null,
	},
	{
		name: 'Ming Wang',
		role: 'Director of Technology',
		initials: 'MW',
		photo: '/images/analysts/ming.jpeg',
		bio: 'Ming Wang is a sophomore from Taipei, Taiwan studying Artificial Intelligence for Business at the Marshall School of Business and Viterbi School of Engineering. Ming focuses on top-down investing within the TMT sector, analyzing secular trends such as the impact of AI to find value dislocations in tech companies, with a particular eye on the proprietary technology behind them. Last summer, Ming worked at Alpha Square Group, a tech-focused family office in New York. Ming will be joining Silicon Motion (NYSE:SIMO) as a PM intern this summer, and will be joining Evercore\'s technology M&A team in Menlo Park as a summer investment banking analyst in 2027.',
	},
	{
		name: 'Sam Wells',
		role: 'Director of Energy & Industry',
		initials: 'SW',
		photo: '/images/analysts/sam.jpeg',
		bio: 'Sam Wells is a sophomore from Syracuse, New York. He is studying Legal Studies and Accounting at the Gould School of Law and the Marshall School of Business. Sam is especially interested in the intersection between law and business, with future goals of working in transactional corporate law, particularly in Mergers & Acquisitions. As Director of Energy & Industry, Sam approaches investing with a unique legal-minded perspective. He prefers proven companies with strong financials and excellent business models, to balance the somewhat aggressive nature of the other sectors. Last summer, Sam worked in-house at American Food & Vending Corp. in both the accounting and legal departments.',
	},
];

const portfolioManagers = [
	{
		name: 'Liam Bennett',
		role: 'Portfolio Manager',
		initials: 'LB',
		photo: '/images/analysts/liam.jpeg',
		bio: 'Liam Bennett is a freshman from Boston, MA studying Business Administration at the USC Marshall School of Business. He is a member of the Value Investing Group and is highly interested in distressed and special situations investing. This summer, he will be joining Greenlight Capital, a value-oriented long/short equity and distressed hedge fund based out of New York City. He will be recruiting for investment banking this fall.',
	},
	{
		name: 'Nicolai Corneliussen',
		role: 'Portfolio Manager',
		initials: 'NC',
		photo: '/images/analysts/nicolai.jpeg',
		bio: 'Nicolai is a sophomore from Novato, California, studying Business Administration with a concentration in finance at the Marshall School of Business. Nicolai approaches investing with an analytical, fundamentals-driven perspective built through hands-on experience. He is drawn to complex capital structures and downside-focused underwriting, favoring companies with durable cash flows and defensible market positions. He is especially interested in debt markets and credit, with future goals of working in leveraged finance. He will be joining Wells Fargo as an Investment Banking Summer Analyst in 2027.',
	},
	{
		name: 'Rhett Rodgers',
		role: 'Portfolio Manager',
		initials: 'RR',
		photo: null,
		bio: null,
	},
];
---

<Layout title={title} description={description}>
	<div class="mx-auto max-w-[1080px] px-6">

		<!-- MASTHEAD -->
		<header class="pt-10 pb-5">
			<div class="flex items-start justify-between gap-8">
				<h1 class="font-serif text-[26px] leading-[1.15] font-medium text-ink max-w-[240px]">
					The Epsilon<br />Omicron<br />Fund
				</h1>

				<!-- DESKTOP NAV -->
				<nav class="hidden md:flex items-center gap-10 pt-2">
					<a href="/" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink hover:text-gold transition-colors">Home</a>
					<a href="/philosophy" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink hover:text-gold transition-colors">Philosophy</a>
					<a href="/letters" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink hover:text-gold transition-colors">Letters</a>
					<a href="/analysts" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink border-b border-gold pb-1">Analysts</a>
					<a href="/contact" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink hover:text-gold transition-colors">Contact</a>
				</nav>

				<!-- MOBILE HAMBURGER -->
				<button
					id="mobile-nav-toggle"
					aria-label="Open menu"
					class="md:hidden flex flex-col justify-center items-center w-10 h-10 mt-2"
				>
					<span class="block w-6 h-px bg-ink mb-1.5"></span>
					<span class="block w-6 h-px bg-ink mb-1.5"></span>
					<span class="block w-6 h-px bg-ink"></span>
				</button>
			</div>

			<!-- MOBILE NAV PANEL -->
			<nav id="mobile-nav-panel" class="hidden md:hidden flex-col gap-5 pt-6 pb-2">
				<a href="/" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink">Home</a>
				<a href="/philosophy" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink">Philosophy</a>
				<a href="/letters" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink">Letters</a>
				<a href="/analysts" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink border-b border-gold pb-1 self-start">Analysts</a>
				<a href="/contact" class="font-sans text-[11px] uppercase tracking-[0.18em] text-ink">Contact</a>
			</nav>
		</header>

		<!-- KICKER -->
		<div class="pb-3">
			<p class="font-sans text-[10px] uppercase tracking-[0.18em] text-gold leading-[1.6]">
				Sigma Nu &middot;<br />Established 2026
			</p>
		</div>
		<hr class="border-0 border-t border-ink" />

	</div>

	<!-- TEAM CONTENT -->
	<section class="mx-auto max-w-[760px] px-6 py-16 md:py-24">

		<!-- PAGE TITLE BLOCK -->
		<div class="text-center">
			<h2 class="font-serif text-[28px] md:text-[34px] leading-[1.2] font-medium text-ink mb-4">
				The Team.
			</h2>
			<p class="font-serif italic text-[15px] text-ink-muted">The investment committee of the Epsilon Omicron Fund.</p>
		</div>

		<!-- SECTION DIVIDER -->
		<hr class="border-0 border-t border-ink mt-12 md:mt-16 mb-12 md:mb-16" />

		<!-- FOUNDERS SECTION -->
		<h3 class="font-serif text-[26px] md:text-[32px] leading-[1.2] font-medium text-ink mb-12 md:mb-16 text-center">
			Founders
		</h3>

		<div class="space-y-12 md:space-y-16">
			{founders.map((analyst) => (
				<article class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-6 md:gap-10 items-start">

					<!-- PHOTO or PLACEHOLDER -->
					{analyst.photo ? (
						<div class="aspect-square w-[140px] md:w-full overflow-hidden mx-auto md:mx-0">
							<img
								src={analyst.photo}
								alt={analyst.name}
								class={`w-full h-full object-cover ${analyst.objectPosition === 'top' ? 'object-top' : ''}`}
							/>
						</div>
					) : (
						<div class="aspect-square w-[140px] md:w-full bg-rule flex items-center justify-center mx-auto md:mx-0">
							<span class="font-serif text-[32px] md:text-[44px] font-medium text-ink-muted">
								{analyst.initials}
							</span>
						</div>
					)}

					<!-- BIO CONTENT -->
					<div class="text-center md:text-left">
						<h3 class="font-serif text-[20px] md:text-[22px] leading-[1.2] font-medium text-ink mb-1">
							{analyst.name}
						</h3>
						<p class="font-sans text-[10px] uppercase tracking-[0.18em] text-gold mb-4 md:mb-5">
							{analyst.role}
						</p>

						{analyst.bio ? (
							<p class="font-serif text-[15px] leading-[1.7] text-ink-soft text-left">
								{analyst.bio}
							</p>
						) : (
							<p class="font-serif italic text-[14px] text-ink-muted">
								Bio coming soon.
							</p>
						)}
					</div>

				</article>
			))}
		</div>

		<!-- SECTION DIVIDER -->
		<hr class="border-0 border-t border-ink mt-20 md:mt-24 mb-12 md:mb-16" />

		<!-- PORTFOLIO MANAGERS SECTION -->
		<h3 class="font-serif text-[26px] md:text-[32px] leading-[1.2] font-medium text-ink mb-12 md:mb-16 text-center">
			Portfolio Managers
		</h3>

		<div class="space-y-12 md:space-y-16">
			{portfolioManagers.map((analyst) => (
				<article class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-6 md:gap-10 items-start">

					<!-- PHOTO or PLACEHOLDER -->
					{analyst.photo ? (
						<div class="aspect-square w-[140px] md:w-full overflow-hidden mx-auto md:mx-0">
							<img
								src={analyst.photo}
								alt={analyst.name}
								class={`w-full h-full object-cover ${analyst.objectPosition === 'top' ? 'object-top' : ''}`}
							/>
						</div>
					) : (
						<div class="aspect-square w-[140px] md:w-full bg-rule flex items-center justify-center mx-auto md:mx-0">
							<span class="font-serif text-[32px] md:text-[44px] font-medium text-ink-muted">
								{analyst.initials}
							</span>
						</div>
					)}

					<!-- BIO CONTENT -->
					<div class="text-center md:text-left">
						<h3 class="font-serif text-[20px] md:text-[22px] leading-[1.2] font-medium text-ink mb-1">
							{analyst.name}
						</h3>
						<p class="font-sans text-[10px] uppercase tracking-[0.18em] text-gold mb-4 md:mb-5">
							{analyst.role}
						</p>

						{analyst.bio ? (
							<p class="font-serif text-[15px] leading-[1.7] text-ink-soft text-left">
								{analyst.bio}
							</p>
						) : (
							<p class="font-serif italic text-[14px] text-ink-muted">
								Bio coming soon.
							</p>
						)}
					</div>

				</article>
			))}
		</div>

	</section>

	<!-- FOOTER -->
	<footer class="bg-ink text-cream py-6">
		<div class="mx-auto max-w-[1080px] px-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 md:gap-0">
			<p class="font-serif italic text-[14px]">Fraternally, since 2026</p>
			<p class="font-sans text-[10px] uppercase tracking-[0.18em] text-gold">&Sigma; N &middot; Epsilon Omicron</p>
		</div>
	</footer>

	<!-- MOBILE NAV TOGGLE SCRIPT -->
	<script>
		const toggle = document.getElementById('mobile-nav-toggle');
		const panel = document.getElementById('mobile-nav-panel');
		toggle?.addEventListener('click', () => {
			panel?.classList.toggle('hidden');
			panel?.classList.toggle('flex');
		});
	</script>
</Layout>